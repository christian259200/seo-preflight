# Copiar a .env y rellenar. .env esta en .gitignore y no se sube nunca.

# DataForSEO. Tambien vale DATA_FOR_SEO="login:password", que es el formato
# que usa la landing, o ~/.config/pengu-seo/dataforseo.json
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Mercado por defecto de las consultas
PENGU_LOCATION=Nicaragua
PENGU_LANGUAGE=Spanish
